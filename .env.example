# Public URL of the deployed site (used for canonical URLs, sitemap, OG)
NEXT_PUBLIC_SITE_URL=

# Stripe Payment Link for donations (create one in the Stripe dashboard:
# Products → Payment links → "Donation" type). Leave empty to hide donate buttons.
NEXT_PUBLIC_STRIPE_DONATE_URL=

# Google PageSpeed Insights API key (optional — raises the quota for the
# Core Web Vitals measurement; works without a key at low volume).
# Get one at https://developers.google.com/speed/docs/insights/v5/get-started
PSI_API_KEY=

# Where the SQLite database lives (defaults to ./data)
# DATA_DIR=/var/data/czech-this-report

# Resend (https://resend.com) — sends the contact-form enquiry by e-mail.
# Without this key, enquiries are still saved to the database but no e-mail
# is sent. Get a key at https://resend.com/api-keys
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend (Domains tab), or
# use the sandbox address below while testing without a custom domain —
# note the sandbox can only send to the Resend account's own e-mail.
#
# IMPORTANT if you set this in a dashboard (Railway/Render/Vercel) instead of
# a local .env file: type the value WITHOUT the surrounding quotes shown
# below — dashboard UIs store the text exactly as typed, they don't strip
# quotes the way a .env file loader does.
#   .env file value:   RESEND_FROM_EMAIL="Czech Th!s Report <onboarding@resend.dev>"
#   dashboard value:   Czech Th!s Report <onboarding@resend.dev>
RESEND_FROM_EMAIL=

# Where contact-form enquiries are delivered (defaults to Ondřej's e-mail)
CONTACT_TO_EMAIL=
